<Window x:Class="BookListApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stephen King Books" Height="450" Width="1100"
        Icon="Resources/ikona.ico">
    <Grid>

        <!-- Opis wyszukiwania -->
        <TextBlock Text="🔍 Wpisz tytuł książki  :" 
               Margin="10,0,0,0" 
               HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               FontWeight="Bold"
               FontSize="14"/>
        <!-- Pole wyszukiwania książek -->
        <TextBox x:Name="SearchTextBox" Width="200" Margin="10,25,0,0" 
             TextChanged="SearchTextBox_TextChanged" 
             HorizontalAlignment="Left" 
             VerticalAlignment="Top" />

        <ListView x:Name="BooksListView" Margin="10,50,10,10" MouseDoubleClick="BooksListView_MouseDoubleClick" SelectionChanged="BooksListView_SelectionChanged">
            <ListView.View>
                <GridView>

                    <!-- Tytuł -->
                    <GridViewColumn Header="Tytuł" DisplayMemberBinding="{Binding Title}" Width="200">
                        <GridViewColumn.HeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <EventSetter Event="Click" Handler="GridViewColumnHeader_Click"/>
                            </Style>
                        </GridViewColumn.HeaderContainerStyle>
                    </GridViewColumn>

                    <!-- Rok -->
                    <GridViewColumn Header="Rok" DisplayMemberBinding="{Binding Year}" Width="80">
                        <GridViewColumn.HeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <EventSetter Event="Click" Handler="GridViewColumnHeader_Click"/>
                            </Style>
                        </GridViewColumn.HeaderContainerStyle>
                    </GridViewColumn>

                    <!-- Wydawnictwo -->
                    <GridViewColumn Header="Wydawnictwo" DisplayMemberBinding="{Binding Publisher}" Width="150">
                        <GridViewColumn.HeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <EventSetter Event="Click" Handler="GridViewColumnHeader_Click"/>
                            </Style>
                        </GridViewColumn.HeaderContainerStyle>
                    </GridViewColumn>

                    <!-- Ilość stron -->
                    <GridViewColumn Header="Strony" DisplayMemberBinding="{Binding Pages}" Width="80">
                        <GridViewColumn.HeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <EventSetter Event="Click" Handler="GridViewColumnHeader_Click"/>
                            </Style>
                        </GridViewColumn.HeaderContainerStyle>
                    </GridViewColumn>

                    <!-- Ocena -->
                    <GridViewColumn Header="Ocena" DisplayMemberBinding="{Binding Rating}" Width="80">
                        <GridViewColumn.HeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <EventSetter Event="Click" Handler="GridViewColumnHeader_Click"/>
                            </Style>
                        </GridViewColumn.HeaderContainerStyle>
                    </GridViewColumn>

                    <!-- Ulubiona -->
                    <GridViewColumn Width="80">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Ulubiona" Tag="IsFavorite" Click="GridViewColumnHeader_Click"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Width="24" Height="24" Cursor="Hand" MouseLeftButtonUp="FavoriteImage_MouseLeftButtonUp"
                   HorizontalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="/Images/heart_empty.png"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Source" Value="/Images/heart_filled.png"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Do przeczytania -->
                    <GridViewColumn Width="100">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Do przeczytania" Tag="IsToRead" Click="GridViewColumnHeader_Click"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsToRead, Mode=TwoWay}" 
                      HorizontalAlignment="Center"
                      Checked="ToReadCheckBox_Checked" 
                      Unchecked="ToReadCheckBox_Unchecked"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Przeczytana -->
                    <GridViewColumn Width="80">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Przeczytana" Tag="IsRead" Click="GridViewColumnHeader_Click"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsRead, Mode=TwoWay}" 
                      HorizontalAlignment="Center"
                      Checked="ReadCheckBox_Checked" 
                      Unchecked="ReadCheckBox_Unchecked"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>


                    <!-- Szczegóły -->
                    <GridViewColumn Header="Szczegóły">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Przycisk do wyświetlenia szczegółów książki -->
                                <Button Content="Szczegóły" Click="DetailsButton_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>


                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
