<Window x:Class="MyApp.BookDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Szczegóły książki" Height="Auto" Width="600"
        SizeToContent="Height">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock x:Name="TitleTextBlock" FontSize="20" Margin="0,0,0,10" />
            <TextBlock x:Name="RatingTextBlock" FontSize="16" Margin="0,0,0,5" />
            <TextBlock x:Name="PublisherTextBlock" FontSize="16" Margin="0,0,0,5" />
            <TextBlock x:Name="YearTextBlock" FontSize="16" Margin="0,0,0,5" />
            <TextBlock x:Name="PagesTextBlock" FontSize="16" Margin="0,0,0,5" />
            <TextBlock x:Name="ISBNTextBlock" FontSize="16" Margin="0,0,0,15" />

            <TextBlock x:Name="NotesLabel" FontSize="16" Text="Notatki:" />
            <ListView x:Name="NotesList" Margin="0,5,0,15"
                      MaxHeight="200"
                      ItemsSource="{Binding Notes}" />
            <TextBlock x:Name="NotesEmptyMessage"
           Text="Brak notatek"
           Foreground="Gray"
           FontStyle="Italic"
           Visibility="Collapsed"
           Margin="10,0,10,10" />


            <TextBlock x:Name="VillainsLabel" FontSize="16" Text="Złoczyńcy:" />
            <ListView x:Name="VillainsList" Margin="0,5,0,15"
                      MaxHeight="200"
                      ItemsSource="{Binding Villains}" />
            <TextBlock x:Name="VillainEmptyMessage"
           Text="Brak złoczyńców"
           Foreground="Gray"
           FontStyle="Italic"
           Visibility="Collapsed"
           Margin="10,0,10,10" />

            <Button Content="Zamknij" Click="Close_Click" HorizontalAlignment="Right" Width="80" />
        </StackPanel>
    </ScrollViewer>
</Window>
