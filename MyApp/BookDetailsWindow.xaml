<Window x:Class="MyApp.BookDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Szczegóły książki" Height="400" Width="600">
    <Grid>
        <TextBlock Name="TitleTextBlock" FontSize="20" Margin="10" />
        <TextBlock Name="RatingTextBlock" FontSize="16" Margin="10,40,10,10" />
        <TextBlock Name="PublisherTextBlock" FontSize="16" Margin="10,80,10,10" />
        <TextBlock Name="YearTextBlock" FontSize="16" Margin="10,120,10,10" />
        <TextBlock Name="PagesTextBlock" FontSize="16" Margin="10,160,10,10" />
        <Button Content="Zamknij" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" />
    </Grid>
</Window>
