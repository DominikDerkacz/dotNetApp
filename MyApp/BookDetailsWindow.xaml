<Window x:Class="MyApp.BookDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Szczegóły książki" Width="800" MinWidth="600"
        SizeToContent="Height"
        Icon="Resources/ikona.ico"> 
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Informacje o książce -->
        <TextBlock x:Name="TitleTextBlock" FontSize="20" Margin="0,0,0,10" Grid.Row="0"/>
        <TextBlock x:Name="RatingTextBlock" FontSize="16" Margin="0,0,0,5" Grid.Row="1"/>
        <TextBlock x:Name="PublisherTextBlock" FontSize="16" Margin="0,0,0,5" Grid.Row="2"/>
        <TextBlock x:Name="YearTextBlock" FontSize="16" Margin="0,0,0,5" Grid.Row="3"/>
        <TextBlock x:Name="PagesTextBlock" FontSize="16" Margin="0,0,0,5" Grid.Row="4"/>
        <TextBlock x:Name="ISBNTextBlock" FontSize="16" Margin="0,0,0,15" Grid.Row="5"/>

        <!-- Notatki -->
        <TextBlock x:Name="NotesLabel" FontSize="16" Text="Notatki:" Grid.Row="6"/>
        <ListView x:Name="NotesList"
          Grid.Row="7"
          ItemsSource="{Binding Notes}"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          MaxHeight="150"/>

        <TextBlock x:Name="NotesEmptyMessage" Text="Brak notatek" Foreground="Gray"
                       FontStyle="Italic" Visibility="Collapsed" Margin="10,0,10,10" Grid.Row="8" />

        <!-- Złoczyńcy -->
        <TextBlock x:Name="VillainsLabel" FontSize="16" Text="Złoczyńcy:" Grid.Row="9"/>

        <ListView x:Name="VillainsList"
          Grid.Row="10"
          ItemsSource="{Binding Villains}"
          HorizontalContentAlignment="Stretch"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          MaxHeight="150">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Name}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Margin="0,0,10,0"/>

                        <Button Content="Szczegóły"
                        Width="80"
                        HorizontalAlignment="Right"
                        Grid.Column="1"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="VillainEmptyMessage"
                       Text="Brak złoczyńców"
                       Foreground="Gray"
                       FontStyle="Italic"
                       Visibility="Collapsed"
                       Margin="10,0,10,10"
                       Grid.Row="11" />

        <!-- Przycisk zamknięcia -->
        <Button Content="Zamknij"
                    Click="Close_Click"
                    HorizontalAlignment="Right"
                    Width="80"
                    Margin="10"
                    Grid.Row="12"/>
    </Grid>
</Window>
